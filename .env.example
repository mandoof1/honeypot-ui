# HoneySentinel AI — environment configuration
# Copy to .env and fill in. Every commented-out value is optional.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "development" allows placeholder secrets (ephemeral ones are generated at
# startup). Anything else is treated as a real deployment and the app refuses
# to start unless the secrets below are set to unique random values.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Secrets — generate each one separately:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=
ENCRYPTION_KEY=
# Shared between the backend and the honeypot engine. They must match or every
# session ingest and control-API call is rejected.
HONEYPOT_INGEST_TOKEN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://honeypot:honeypot@localhost:5433/honeysentinel
DATABASE_URL_SYNC=postgresql+psycopg2://honeypot:honeypot@localhost:5433/honeysentinel

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Enable ONLY when running behind a trusted reverse proxy (Render, Vercel,
# nginx). Otherwise clients can spoof X-Forwarded-For to evade rate limits.
TRUST_PROXY_HEADERS=false
RATE_LIMIT_PER_MINUTE=60
# Populate an empty database with the demo dataset on first boot.
SEED_ON_STARTUP=false

# ---------------------------------------------------------------------------
# GeoIP — optional
# ---------------------------------------------------------------------------
# Download GeoLite2-City.mmdb from MaxMind (free account required). Without it,
# sessions are stored with no location rather than a guessed one.
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# ---------------------------------------------------------------------------
# Alerting — optional. Leave blank to disable.
# ---------------------------------------------------------------------------
# The backend tries Brevo, SendGrid, Resend, then SMTP, in that order.
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Where high/critical alerts are delivered.
ALERT_EMAIL_TO=
WEBHOOK_URL=
# Optional HMAC secret; receivers can verify the X-HoneySentinel-Signature
# header to confirm an alert really came from this deployment.
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI models
# ---------------------------------------------------------------------------
# If these files are absent, bootstrap models are fitted on synthetic data and
# every verdict is tagged model_source="synthetic".
MODEL_PATH_RF=./models/random_forest_model.pkl
MODEL_PATH_IF=./models/isolation_forest_model.pkl
SPACY_MODEL=en_core_web_sm

# ---------------------------------------------------------------------------
# Honeypot engine
# ---------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000/api/v1
# Where the backend reaches the engine's control API.
HONEYPOT_CONTROL_URL=http://localhost:8001
HONEYPOT_NODE_NAME=honeypot-engine-main
# Persistent writable directory: raw archives and delivery.sqlite3 contain
# sensitive capture evidence. See docs/CAPTURE_AND_CORRELATION.md.
# HONEYPOT_CAPTURE_DIR=./data/sessions
HONEYPOT_PROTOCOLS=ssh,ftp,http
HONEYPOT_OPERATIONAL_MODE=active
HONEYPOT_SSH_PORT=2222
HONEYPOT_FTP_PORT=2121
HONEYPOT_HTTP_PORT=8080
HONEYPOT_HTTPS_PORT=8443
HONEYPOT_CONTROL_PORT=8000
HONEYPOT_ANTI_FINGERPRINT=true
HONEYPOT_ADAPTIVE_RESPONSE=true
HONEYPOT_ENABLE_ISOLATION=true
HONEYPOT_RATE_LIMIT=60
# Optional TLS material for the HTTPS emulator. A self-signed certificate is
# generated at startup when these are unset.
# HONEYPOT_TLS_CERT=
# HONEYPOT_TLS_KEY=

# ---------------------------------------------------------------------------
# Frontend (build-time)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
