# HoneySentinel — settings for local development.
#
# ./start.sh copies this to .env and fills in the three secrets. It serves the
# development stack (docker-compose.yml) and a backend or engine run by hand.
# A real deployment does not use this file: deploy/server/install.sh writes
# its own .env.
#
# This is a starting set, not the full list. Every setting, with its default
# and which component reads it, is in docs/CONFIGURATION.md.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "development" allows placeholder secrets (ephemeral ones are generated at
# startup). Anything else is treated as a real deployment and the app refuses
# to start unless the secrets below are set to unique random values.
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Secrets — generate each one separately:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=
ENCRYPTION_KEY=
# Shared between the backend and the engine in development. The engine exits
# (code 78) rather than run with the published default, so this must be set.
# Deployments use one token per engine instead (HONEYPOT_NODE_TOKENS) plus
# HONEYPOT_CONTROL_TOKEN; see docs/CONFIGURATION.md.
HONEYPOT_INGEST_TOKEN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://honeypot:honeypot@localhost:5433/honeysentinel
DATABASE_URL_SYNC=postgresql+psycopg2://honeypot:honeypot@localhost:5433/honeysentinel

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Enable ONLY behind a reverse proxy you control, and then list that proxy's
# address in TRUSTED_PROXIES. Otherwise clients can spoof X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# TRUSTED_PROXIES=127.0.0.0/8,::1
RATE_LIMIT_PER_MINUTE=60
# Populate an empty database with the demo dataset (150 synthetic sessions)
# on first boot. Development only; never beside captured traffic.
SEED_ON_STARTUP=false
# Run the queue, outbox, liveness and retention workers in this process.
# Exactly one API process per deployment has this on.
BACKGROUND_WORKERS=true
# Days captured sessions and audit entries are kept. 0 keeps sessions for
# ever, which a deployment should decide deliberately (docs/DATA_HANDLING.md).
SESSION_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# GeoIP — optional
# ---------------------------------------------------------------------------
# A MaxMind GeoLite2-City.mmdb (free account required) or DB-IP's City Lite
# (no account; CC BY 4.0, so credit it — set VITE_GEOIP_ATTRIBUTION). Without
# one, sessions are stored with no location rather than a guessed one.
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# ---------------------------------------------------------------------------
# Alerting — optional. Leave blank to disable.
# ---------------------------------------------------------------------------
# The backend tries Brevo, SendGrid, Resend, then SMTP, in that order. Without
# a mail provider, sign-up and password reset answer 503.
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
WEBHOOK_URL=
# Optional HMAC secret; receivers can verify the X-HoneySentinel-Signature
# header to confirm an alert really came from this deployment.
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# If these files are absent, bootstrap models are fitted on synthetic data and
# every verdict is tagged model_source="synthetic".
MODEL_PATH_RF=./models/random_forest_model.pkl
MODEL_PATH_IF=./models/isolation_forest_model.pkl
SPACY_MODEL=en_core_web_sm

# Language model (stage 2) and decision model (triage) — both optional, both
# local llama.cpp servers called from the backend, never from the engine.
# CHIMERA_URL=http://127.0.0.1:8081/v1
# CHIMERA_MODEL=wolfram
# DECIDER_URL=http://127.0.0.1:8082
# DECIDER_MODEL=kev-4b
# DECIDER_SKIP_THRESHOLD=0.85
# DECIDER_SUPPORT_THRESHOLD=0.3

# ---------------------------------------------------------------------------
# Honeypot engine
# ---------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:8000/api/v1
# The engine's control API, and where the backend reaches it. One port, set
# in both places. 8001 here because, run by hand on one machine, the API
# itself has 8000 (in the compose files each has its own container).
HONEYPOT_CONTROL_PORT=8001
HONEYPOT_CONTROL_URL=http://localhost:8001
HONEYPOT_NODE_NAME=honeypot-engine-main
# Any of ssh,telnet,ftp,http,https. https serves TLS on HONEYPOT_HTTPS_PORT.
HONEYPOT_PROTOCOLS=ssh,telnet,ftp,http
HONEYPOT_OPERATIONAL_MODE=active
HONEYPOT_SSH_PORT=2222
HONEYPOT_TELNET_PORT=2323
HONEYPOT_FTP_PORT=2121
HONEYPOT_HTTP_PORT=8080
HONEYPOT_HTTPS_PORT=8443
HONEYPOT_ANTI_FINGERPRINT=true
HONEYPOT_ADAPTIVE_RESPONSE=true
HONEYPOT_ENABLE_ISOLATION=true
HONEYPOT_RATE_LIMIT=60
# Canary strings that only an AI agent reading the decoy's output would act on.
HONEYPOT_AI_CANARY=true
# A real web application for the HTTP/HTTPS decoys to front, and optionally a
# decoy copy of it that clients giving themselves away are diverted to.
# HONEYPOT_HTTP_UPSTREAM=http://shop:3000
# HONEYPOT_HTTP_UPSTREAM_OWNS=/login,/admin
# HONEYPOT_HTTP_DECOY_UPSTREAM=http://shop-decoy:3000
# HONEYPOT_HTTP_SESSION_COOKIE=sid
# FTP passive-mode data ports. These must be published alongside the control
# port for STOR/RETR to work, and behind NAT (Docker included) the advertised
# address must be the one clients can reach, not the container's own.
HONEYPOT_FTP_PASV_PORTS=50000-50009
# HONEYPOT_FTP_PASV_ADDRESS=
# Optional TLS material for the HTTPS emulator. A self-signed certificate is
# generated at startup when these are unset.
# HONEYPOT_TLS_CERT=
# HONEYPOT_TLS_KEY=

# ---------------------------------------------------------------------------
# Frontend (build-time)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
# Credit line appended to the map's attribution (HTML), e.g. for DB-IP Lite.
# VITE_GEOIP_ATTRIBUTION=<a href="https://db-ip.com">IP Geolocation by DB-IP</a>
