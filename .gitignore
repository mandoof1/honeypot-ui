# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment: every .env and every copy or variant of one, anywhere.
# Only the documented examples are tracked.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Backend
backend/__pycache__
backend/*/__pycache__
backend/*/*/__pycache__
backend/models/*.pkl
backend/data/
*.egg-info

# Frontend
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.pkl
.pytest_cache/
.ruff_cache/

# Model files and geolocation databases: large, licensed, fetched by script.
*.gguf
*.mmdb
*.mmdb.gz

# Captured honeypot data (never commit attacker payloads)
data/
!data/.gitkeep

# Deployment state: secrets, certificates, backups' leftovers, tool output.
deploy/**/state/
deploy/server/egress.conf

# Editor swap files
*.kate-swp
*.swp

# Browser test artifacts
playwright-report/
test-results/
