{
	admin off
	auto_https off
	servers {
		# Tailscale Serve terminates TLS on the host and forwards from
		# loopback, which reaches this container through Docker's bridge.
		# Trusting private ranges keeps the X-Forwarded-For it sets, so the
		# API's per-client rate limit sees the real tailnet address.
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Tailscale Serve terminates TLS; this is what the browser sees.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Tokens live in localStorage, so script injection is the thing to
		# shut out: scripts only from this origin (Vite inlines nothing),
		# styles and fonts from here and Google Fonts (index.html), map tiles
		# from OpenStreetMap, API calls to self only.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Service-to-service routes are for the engine, which talks to the
	# ingest service directly on the internal network. Nothing arriving
	# through the dashboard proxy has a reason to reach them.
	@internal path_regexp internal -internal(/|$)
	handle @internal {
		respond 404
	}

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
