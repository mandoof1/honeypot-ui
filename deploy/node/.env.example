# Where captured sessions are shipped. Include the /api/v1 suffix.
BACKEND_API_URL=https://honeysentinel-api.onrender.com/api/v1

# Must be byte-identical to HONEYPOT_INGEST_TOKEN on the backend.
# Read it from the Render dashboard: Service -> Environment.
HONEYPOT_INGEST_TOKEN=

# Name this node reports itself under. Give each node its own.
HONEYPOT_NODE_NAME=oracle-free-node-1

# Which emulators to bind. FTP and HTTP draw the most automated traffic;
# https additionally needs HONEYPOT_TLS_CERT/KEY or it stays disabled.
HONEYPOT_PROTOCOLS=ssh,ftp,telnet,http

# active  = answer connections and record the full session
# passive = log the connection attempt only
HONEYPOT_OPERATIONAL_MODE=active

HONEYPOT_ANTI_FINGERPRINT=true
HONEYPOT_ADAPTIVE_RESPONSE=true
HONEYPOT_ENABLE_ISOLATION=true

# Per-IP throttling. Internet background noise is relentless; these keep a
# single scanner from filling the database.
HONEYPOT_MAX_CONN_PER_IP=5
HONEYPOT_RATE_LIMIT=60

# Optional: serve a real certificate on 8443 instead of leaving HTTPS off.
# HONEYPOT_TLS_CERT=/app/data/tls/fullchain.pem
# HONEYPOT_TLS_KEY=/app/data/tls/privkey.pem
