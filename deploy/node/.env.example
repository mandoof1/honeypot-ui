# Remote sensor settings. Copy to .env (mode 600) and fill in; README.md
# walks through each value. No cloud-provider credential belongs in here.

# The name this sensor reports under, and the token issued for that name on
# the server (sudo python3 deploy/server/node_tokens.py add <name>). The
# server rejects the token under any other name.
HONEYPOT_NODE_NAME=
HONEYPOT_NODE_TOKEN=

# The server's ingest endpoint on the private overlay (its WireGuard or
# Tailscale address, and SENSOR_INGEST_PORT there). This is the only place
# the engine is allowed to connect to; bootstrap.sh writes the firewall rule
# from these two values, so re-run it after changing them.
INGEST_ADDR=
INGEST_PORT=8001

# The IPv4 address on this machine's public interface, which the decoy ports
# are bound to. On clouds that NAT the public address (Oracle, AWS, GCP) this
# is the private one shown by `ip -4 addr`, not the public one.
SENSOR_BIND_IPV4=
# The address clients see. Passive FTP advertises it.
SENSOR_PUBLIC_IPV4=

# Which emulators to run, and how they start.
HONEYPOT_PROTOCOLS=ssh,telnet,ftp,http,https
# active  = answer connections and record the full session
# passive = record the connection attempt only
HONEYPOT_OPERATIONAL_MODE=active

# Generated by bootstrap.sh; protects a control API that only answers on
# loopback inside the container.
# HONEYPOT_CONTROL_TOKEN=
