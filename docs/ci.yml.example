name: Quality checks
on:
  pull_request:
  push:
    branches: [main, master]
permissions:
  contents: read
concurrency:
  group: checks-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true
jobs:
  frontend:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm run check
      - run: npx playwright install --with-deps chromium
      - run: npm run test:e2e
      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: browser-test-results
          path: test-results/
  backend:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_USER: honeysentinel
          POSTGRES_PASSWORD: test-only-password
          POSTGRES_DB: honeysentinel_test
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U honeysentinel -d honeysentinel_test"
          --health-interval 5s --health-timeout 5s --health-retries 10
    env:
      TEST_POSTGRES_URL: postgresql+asyncpg://honeysentinel:test-only-password@127.0.0.1:5432/honeysentinel_test
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip
          cache-dependency-path: |
            backend/requirements-test.txt
            backend/requirements.txt
            honeypot/requirements.txt
      - run: pip install -r backend/requirements-test.txt -r honeypot/requirements.txt
      - run: python -m pytest backend/tests -q
      - run: python -m pytest honeypot/tests -q
